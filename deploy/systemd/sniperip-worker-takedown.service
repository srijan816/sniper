[Unit]
Description=SniperIP Celery Worker (takedown queue — RPA, serial execution)
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=sniperip
Group=sniperip
WorkingDirectory=/opt/sniperip/backend
EnvironmentFile=/opt/sniperip/.env
ExecStart=/opt/sniperip/venv/bin/celery -A app.celery_app.celery_app worker \
    --loglevel=info \
    --queues=takedown \
    --concurrency=2 \
    --hostname=worker-takedown@%h
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sniperip-worker-takedown

[Install]
WantedBy=multi-user.target
