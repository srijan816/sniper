# Oracle production .env template for 140.245.107.78
# Copy to repo root:  cp deploy/env.oracle.example .env
# Then fill every secret marked CHANGE_ME before first deploy.

PUBLIC_HOST=140.245.107.78

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_DB_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_STARTER_PRICE_ID=price_CHANGE_ME
STRIPE_GROWTH_PRICE_ID=price_CHANGE_ME
STRIPE_AGENCY_PRICE_ID=price_CHANGE_ME

# --- SerpApi (discovery) ---
SERPAPI_KEY=CHANGE_ME

# --- Resend (email) ---
RESEND_API_KEY=re_CHANGE_ME

# --- Redis (Docker internal — do not change) ---
REDIS_URL=redis://redis:6379/0

# --- HuggingFace (vision ensemble) ---
HUGGINGFACE_API_TOKEN=hf_CHANGE_ME
HUGGINGFACE_EMBEDDING_MODEL=google/siglip-so400m-patch14-384
HUGGINGFACE_EMBEDDING_BACKEND=auto
HUGGINGFACE_ALLOW_SHARED_FALLBACK=true
HUGGINGFACE_ALLOW_OPENAI_FALLBACK=false

# --- MiniMax (threat explanations) ---
MINIMAX_API_KEY=CHANGE_ME

# --- AI-Q research ---
AIQ_BASE_URL=https://app2.sniperip.com
AIQ_API_TOKEN=CHANGE_ME

# --- URLs (Oracle IP — update PUBLIC_HOST if using a domain) ---
NEXT_PUBLIC_APP_URL=http://140.245.107.78
NEXT_PUBLIC_BACKEND_URL=http://140.245.107.78/api
BACKEND_URL=http://api:8000
FRONTEND_URL=http://140.245.107.78
CORS_ORIGINS=http://140.245.107.78,https://sniperip.com,http://localhost:3000

# --- Admin ---
ADMIN_EMAILS=admin@yourdomain.com

# --- Production flags ---
ENVIRONMENT=production
LOG_JSON=true
PROMETHEUS_ENABLED=true
METRICS_AUTH_TOKEN=CHANGE_ME_RANDOM_METRICS_TOKEN
STRIPE_WEBHOOK_ALLOW_UNSIGNED=false
TAKEDOWN_TEST_MODE_NO_SUBMIT=true

# --- Discovery ---
DISCOVERY_ENABLE_SHOPPING_SEARCH=true
DISCOVERY_ENABLE_BING_REVERSE=true
DISCOVERY_FAST_REJECT_MARGIN=0.12
SIMILARITY_THRESHOLD=0.90
