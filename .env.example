# ============================================
# SniperIP Environment Variables (Template)
# Copy to .env for local/production use
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=assets
EVIDENCE_STORAGE_BUCKET=evidence-locker
LOA_STORAGE_BUCKET=legal-documents

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_GROWTH_PRICE_ID=price_xxx
STRIPE_AGENCY_PRICE_ID=price_xxx

# --- SerpApi ---
SERPAPI_KEY=your-serpapi-key
SERPAPI_ENGINE=google_lens

# --- Resend ---
RESEND_API_KEY=re_xxx
NOTIFICATION_FROM_EMAIL=SniperIP <noreply@sniperip.com>

# --- Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# --- Redis (Celery Broker) ---
REDIS_URL=redis://localhost:6379/0

# --- DocuSign ---
DOCUSIGN_INTEGRATION_KEY=xxx
DOCUSIGN_SECRET_KEY=xxx
DOCUSIGN_ACCOUNT_ID=xxx

# --- ZenRows ---
ZENROWS_API_KEY=xxx
ZENROWS_PROXY_USERNAME=
ZENROWS_PROXY_PASSWORD=
ZENROWS_PROXY_SERVER=http://superproxy.zenrows.com:1337

# --- HuggingFace ---
HUGGINGFACE_API_TOKEN=hf_xxx
HUGGINGFACE_EMBEDDING_MODEL=google/siglip-base-patch16-224
HUGGINGFACE_EMBEDDING_BACKEND=endpoint
HUGGINGFACE_INFERENCE_ENDPOINT_URL=
HUGGINGFACE_INFERENCE_ENDPOINT_TOKEN=
HUGGINGFACE_ALLOW_SHARED_FALLBACK=true
EMBEDDING_REQUEST_RETRIES=3
SIMILARITY_THRESHOLD=0.95
PHASH_DISTANCE_THRESHOLD=6

# --- Automation ---
TWO_CAPTCHA_API_KEY=your-2captcha-key
SHOPIFY_DMCA_FORM_URL=https://www.shopify.com/legal/report-aup-violation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_STEALTH_ENABLED=true
PLAYWRIGHT_PROXY_SERVER=
PLAYWRIGHT_PROXY_USERNAME=
PLAYWRIGHT_PROXY_PASSWORD=
PLAYWRIGHT_PROXY_BYPASS=
PLAYWRIGHT_PROXY_POOL=
PLAYWRIGHT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
DISCOVERY_TICK_INTERVAL_SECONDS=900
DISCOVERY_CLIENT_SPACING_SECONDS=30

# --- Meta / Amazon Enforcement ---
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_IP_REPORT_ENDPOINT=https://graph.facebook.com/v20.0/ip_reports
AMAZON_BRAND_REGISTRY_ENDPOINT=
AMAZON_BRAND_REGISTRY_API_KEY=

# --- App ---
# Public web URL
NEXT_PUBLIC_APP_URL=https://sniperip.com

# Frontend -> backend API base URL
NEXT_PUBLIC_BACKEND_URL=https://sniperip.com/api

# Internal/backend URLs
BACKEND_URL=http://127.0.0.1:30002
FRONTEND_URL=https://sniperip.com

# Comma-separated admin emails
ADMIN_EMAILS=srijan816@gmail.com

# Keep false in production to avoid seeded demo records
ENABLE_DEMO_DATA=false
