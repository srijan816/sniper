# ============================================
# SniperIP Environment Variables (Template)
# Copy to .env for local/production use
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=assets
EVIDENCE_STORAGE_BUCKET=evidence-locker
LOA_STORAGE_BUCKET=legal-documents

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_GROWTH_PRICE_ID=price_xxx
STRIPE_AGENCY_PRICE_ID=price_xxx

# --- SerpApi ---
SERPAPI_KEY=your-serpapi-key
SERPAPI_ENGINE=google_lens

# --- Resend ---
RESEND_API_KEY=re_xxx
NOTIFICATION_FROM_EMAIL=SniperIP <noreply@sniperip.com>

# --- Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# --- Redis (Celery Broker) ---
REDIS_URL=redis://localhost:6379/0

# --- DocuSign ---
DOCUSIGN_INTEGRATION_KEY=xxx
DOCUSIGN_SECRET_KEY=xxx
DOCUSIGN_ACCOUNT_ID=xxx

# --- ZenRows ---
ZENROWS_API_KEY=xxx
ZENROWS_PROXY_USERNAME=
ZENROWS_PROXY_PASSWORD=
ZENROWS_PROXY_SERVER=http://superproxy.zenrows.com:1337

# --- OpenAI ---
OPENAI_API_KEY=sk-xxx

# --- HuggingFace / Vision Ensemble ---
HUGGINGFACE_API_TOKEN=hf_xxx
HUGGINGFACE_EMBEDDING_MODEL=google/siglip-so400m-patch14-384
HUGGINGFACE_EMBEDDING_BACKEND=auto
HUGGINGFACE_INFERENCE_ENDPOINT_URL=
HUGGINGFACE_INFERENCE_ENDPOINT_TOKEN=
HUGGINGFACE_ALLOW_SHARED_FALLBACK=true
HUGGINGFACE_ALLOW_OPENAI_FALLBACK=false
EMBEDDING_REQUEST_RETRIES=3
EMBEDDING_DIMENSION=1152
EMBEDDING_INPUT_SIZE=384

# DINOv2 structural similarity (ensemble verification)
DINOV2_ENABLED=true
DINOV2_MODEL=facebook/dinov2-large
DINOV2_BACKEND=shared

# Ensemble weights — from AI-Q vision-ensemble research (siglip 0.55 + dinov2 0.40 + phash 0.05)
SIMILARITY_WEIGHT_SIGLIP=0.55
SIMILARITY_WEIGHT_DINOV2=0.40
SIMILARITY_WEIGHT_PHASH=0.05
SIMILARITY_THRESHOLD=0.90
PHASH_DISTANCE_THRESHOLD=6

# --- MiniMax M3 (threat explanations) ---
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# --- AI-Q Deep Research (pipeline intelligence; run jobs one at a time) ---
AIQ_BASE_URL=https://app2.sniperip.com
AIQ_API_TOKEN=
RESEARCH_POLL_INTERVAL_SECONDS=120

# --- Discovery sources ---
DISCOVERY_ENABLE_SHOPPING_SEARCH=true
DISCOVERY_ENABLE_BING_REVERSE=true

# --- Automation ---
TWO_CAPTCHA_API_KEY=your-2captcha-key
SHOPIFY_DMCA_FORM_URL=https://www.shopify.com/legal/report-aup-violation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_STEALTH_ENABLED=true
PLAYWRIGHT_PROXY_SERVER=
PLAYWRIGHT_PROXY_USERNAME=
PLAYWRIGHT_PROXY_PASSWORD=
PLAYWRIGHT_PROXY_BYPASS=
PLAYWRIGHT_PROXY_POOL=
PLAYWRIGHT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
DISCOVERY_TICK_INTERVAL_SECONDS=900
DISCOVERY_CLIENT_SPACING_SECONDS=30

# --- Meta / Amazon Enforcement ---
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_IP_REPORT_ENDPOINT=https://graph.facebook.com/v20.0/ip_reports
AMAZON_BRAND_REGISTRY_ENDPOINT=
AMAZON_BRAND_REGISTRY_API_KEY=

# --- App ---
# Public web URL
NEXT_PUBLIC_APP_URL=https://sniperip.com

# Frontend -> backend API base URL
NEXT_PUBLIC_BACKEND_URL=https://sniperip.com/api

# Internal/backend URLs
BACKEND_URL=http://127.0.0.1:30002
FRONTEND_URL=https://sniperip.com

# Comma-separated admin emails
ADMIN_EMAILS=admin@yourdomain.com

# Keep false in production to avoid seeded demo records
ENABLE_DEMO_DATA=false

# Never submit real takedowns during local/testing (Shopify RPA, Meta, email)
TAKEDOWN_TEST_MODE_NO_SUBMIT=true
